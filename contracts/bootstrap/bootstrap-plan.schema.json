{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haggisSupper/erasmus-protomenta/contracts/bootstrap/bootstrap-plan.schema.json",
  "title": "Bootstrap control-plane plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "plan_id",
    "plan_version",
    "installation_context",
    "required_components",
    "optional_components",
    "runtime_policy",
    "cumulative_budget_ms",
    "degraded_mode",
    "rollback_order",
    "stop_condition",
    "evidence_destination",
    "dependency_graph"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 5
    },
    "plan_version": {
      "type": "string",
      "minLength": 5
    },
    "installation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_context", "installer", "configuration_digest", "platform", "architecture"],
      "properties": {
        "project_context": {
          "type": "string",
          "minLength": 1
        },
        "installer": {
          "type": "string",
          "enum": ["manual", "automated"]
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 8
        },
        "platform": {
          "type": "string",
          "enum": ["windows", "linux", "darwin"]
        },
        "architecture": {
          "type": "string",
          "enum": ["x64", "x86", "arm64"]
        }
      }
    },
    "required_components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "optional_components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      },
      "uniqueItems": true,
      "default": []
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_runtime", "fallback_runtime", "authorized_fallback_override"],
      "properties": {
        "primary_runtime": {
          "type": "string",
          "minLength": 4
        },
        "fallback_runtime": {
          "type": ["string", "null"],
          "minLength": 4
        },
        "authorized_fallback_override": {
          "type": "boolean"
        }
      }
    },
    "cumulative_budget_ms": {
      "type": "integer",
      "minimum": 1
    },
    "retry_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "startup_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      },
      "uniqueItems": true
    },
    "shutdown_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      },
      "uniqueItems": true
    },
    "degraded_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "threshold", "degraded_ready_policy"],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "threshold": {
          "type": "integer",
          "minimum": 0
        },
        "degraded_ready_policy": {
          "type": "string",
          "enum": ["continue", "warn", "blocked"]
        }
      }
    },
    "rollback_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      },
      "uniqueItems": true
    },
    "stop_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_status", "evidence_required", "hard_stop_ms"],
      "properties": {
        "required_status": {
          "type": "string",
          "enum": ["success", "degraded", "blocked", "rollback"]
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["jsonl", "json", "contract"]
          }
        },
        "hard_stop_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence_destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_version", "append_only", "destination_type"],
      "properties": {
        "record_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "append_only": {
          "type": "boolean",
          "const": true
        },
        "destination_type": {
          "type": "string",
          "enum": ["jsonl", "sqlite", "file"]
        },
        "destination": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency_graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "depends_on"],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 4
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 4
            },
            "default": [],
            "uniqueItems": true
          }
        }
      }
    }
  }
}
