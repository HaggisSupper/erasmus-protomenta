{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson",
  "type": "object",
  "required": [
    "id",
    "scope",
    "state",
    "problem",
    "learned_path",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "case",
        "domain",
        "project",
        "meta",
        "optimization_motif"
      ]
    },
    "state": {
      "enum": [
        "candidate",
        "observed",
        "corroborated",
        "validated",
        "enforced",
        "deprecated"
      ]
    },
    "problem": {
      "type": "object"
    },
    "learned_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_shortcuts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "applicability": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$comment": "Experimental design seed. Non-authoritative; not registered with the Erasmus runtime.",
  "x-erasmus-contract": {
    "status": "experimental",
    "authority": "none",
    "runtime_registered": false,
    "promotion_requires": [
      "bounded_mission",
      "versioned_contract_review",
      "deterministic_and_negative_tests",
      "migration_and_rollback"
    ]
  }
}
