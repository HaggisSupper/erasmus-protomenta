{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erasmus.local/contracts/repository-mission.schema.json",
  "title": "Guarded local repository mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identifier",
    "objective",
    "workspace_root",
    "repository_root",
    "expected_base_sha",
    "branch",
    "allowed_paths",
    "patch_source",
    "test_command",
    "test_timeout",
    "retry_limit",
    "stopping_condition",
    "rollback_command_description",
    "implementer",
    "reviewer",
    "reviewer_authority",
    "countercase"
  ],
  "properties": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "workspace_root": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "expected_base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "branch": {"type": "string", "minLength": 1, "maxLength": 255},
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "patch_source": {"enum": ["declared", "worker"]},
    "declared_patch": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "worker_request": {"type": "object", "maxProperties": 64},
    "test_command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "test_timeout": {"type": "integer", "minimum": 1, "maximum": 3600},
    "retry_limit": {"type": "integer", "minimum": 0, "maximum": 10},
    "stopping_condition": {"const": "awaiting_human"},
    "rollback_command_description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "implementer": {"type": "string", "minLength": 1, "maxLength": 128},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 128},
    "reviewer_authority": {"const": "repository:review"},
    "countercase": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "allOf": [
    {
      "if": {"properties": {"patch_source": {"const": "declared"}}},
      "then": {"required": ["declared_patch"], "not": {"required": ["worker_request"]}}
    },
    {
      "if": {"properties": {"patch_source": {"const": "worker"}}},
      "then": {"required": ["worker_request"], "not": {"required": ["declared_patch"]}}
    }
  ]
}
